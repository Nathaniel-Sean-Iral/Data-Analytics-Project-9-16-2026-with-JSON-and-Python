# Repo root. The backend/ and frontend/ directories have their own; this covers
# root-level and cross-cutting artifacts.
#
# Secrets: a .env at the root is the natural place to put SECRET_KEY for
# `docker compose up`, and it must never be committed.
.env
.env.*
!.env.example

# Local databases
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
.vite/
coverage/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
