# Development defaults (backend reads DATABASE_URL, API_PREFIX, ENVIRONMENT,
# SECRET_KEY, SEED_DEMO_DATA, DEMO_PASSWORD, CORS_ORIGINS).
DATABASE_URL=sqlite:///./disaster_prep.db
API_PREFIX=/api

POSTGRES_DB=disaster_prep
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---------------------------------------------------------------------------
# REQUIRED outside development. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=

# SEED_DEMO_DATA=true
# DEMO_PASSWORD=password

# Production compose (docker-compose.prod.yml) reads HTTP_PORT and CORS.
HTTP_PORT=80
# CORS_ORIGINS=["http://localhost"]