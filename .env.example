# Copy to .env and fill in. Never commit .env.
#
# Leave SECRET_KEY blank and the API container generates a strong one on first
# run, persisting it in the api_secret volume. Set it explicitly to keep the
# same key across `docker compose down -v`, or to supply your own in CI.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Only needed if you want a fixed key; otherwise the entrypoint generates one.
# ACCESS_TOKEN_EXPIRE_MINUTES=480

# Narrow this for anything reachable from a real network:
# CORS_ORIGINS=["https://drrm.gov.ph"]
